    "@vitejs/plugin-react": "^6.1.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  },
  "packageManager": "pnpm@11.13.1"
}
